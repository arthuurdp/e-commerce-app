<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_home"
    app:startDestination="@id/homeFragment"
    app:enterAnim="@anim/fade_in"
    app:exitAnim="@anim/fade_out"
    app:popEnterAnim="@anim/fade_in"
    app:popExitAnim="@anim/fade_out">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ecommerce.app.ui.customer.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />

        <action
            android:id="@+id/action_homeFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.ecommerce.app.ui.customer.products.ProductDetailFragment"
        android:label="Product"
        tools:layout="@layout/fragment_product_detail">

        <argument
            android:name="productId"
            app:argType="long" />

        <argument
            android:name="email"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_productDetailFragment_to_cartFragment"
            app:destination="@id/cartFragment" />

        <action
            android:id="@+id/action_productDetailFragment_to_enterCodeFragment"
            app:destination="@id/enterCodeFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.ecommerce.app.ui.customer.cart.CartFragment"
        android:label="Cart"
        tools:layout="@layout/fragment_cart">

        <action
            android:id="@+id/action_cartFragment_to_checkoutFragment"
            app:destination="@id/checkoutFragment" />

        <action
            android:id="@+id/action_cartFragment_to_addAddressFragment"
            app:destination="@id/addAddressFragment" />

    </fragment>

    <fragment
        android:id="@+id/addAddressFragment"
        android:name="com.ecommerce.app.ui.customer.address.AddAddressFragment"
        android:label="Add Address"
        tools:layout="@layout/fragment_add_address" />

    <fragment
        android:id="@+id/checkoutFragment"
        android:name="com.ecommerce.app.ui.customer.cart.CheckoutFragment"
        android:label="Checkout"
        tools:layout="@layout/fragment_checkout">

        <action
            android:id="@+id/action_checkoutFragment_to_paymentWaitingFragment"
            app:destination="@id/paymentWaitingFragment"
            app:popUpTo="@id/checkoutFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/paymentWaitingFragment"
        android:name="com.ecommerce.app.ui.customer.payment.PaymentWaitingFragment"
        android:label="Payment">
        <argument
            android:name="orderId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/paymentSuccessFragment"
        android:name="com.ecommerce.app.ui.customer.payment.PaymentSuccessFragment"
        android:label="Payment">
        <argument
            android:name="orderId"
            app:argType="long" />
        <deepLink app:uri="ecommerce://payment/success?orderId={orderId}" />
        <action
            android:id="@+id/action_paymentSuccessFragment_to_ordersFragment"
            app:destination="@id/ordersFragment" />
    </fragment>

    <fragment
        android:id="@+id/paymentFailureFragment"
        android:name="com.ecommerce.app.ui.customer.payment.PaymentFailureFragment"
        android:label="Payment">
        <argument
            android:name="orderId"
            app:argType="long" />
        <deepLink app:uri="ecommerce://payment/failure?orderId={orderId}" />
        <action
            android:id="@+id/action_paymentFailureFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
    </fragment>

    <fragment
        android:id="@+id/ordersFragment"
        android:name="com.ecommerce.app.ui.customer.orders.OrdersFragment"
        android:label="My Orders"
        tools:layout="@layout/fragment_order_list">
        <action
            android:id="@+id/action_ordersFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.ecommerce.app.ui.customer.orders.OrderDetailFragment"
        android:label="Order Details"
        tools:layout="@layout/fragment_order_detail">
        <argument
            android:name="orderId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/enterCodeFragment"
        android:name="com.ecommerce.app.ui.shared.EnterCodeFragment"
        android:label="Enter Code"
        tools:layout="@layout/fragment_enter_code">

        <argument
            android:name="mode"
            android:defaultValue="none"
            app:argType="string" />

        <argument
            android:name="email"
            android:defaultValue=""
            app:argType="string" />

        <action
            android:id="@+id/action_enterCodeFragment_to_resetPasswordFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>