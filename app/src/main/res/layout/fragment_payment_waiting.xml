<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background">

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/primary"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Waiting for payment…"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Complete the payment in your browser.\nThis screen will update automatically."
        android:textColor="@color/gray"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_orders"
        style="@style/App.Button.Primary"
        android:layout_marginTop="32dp"
        android:text="View My Orders"
        android:visibility="gone" />

</LinearLayout>